<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest
  Version="6.0"
  ExtensionBundleId="com.clipcolorchanger.panel"
  ExtensionBundleVersion="1.0.0"
  ExtensionBundleName="Clip Color Changer"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.clipcolorchanger.panel.main" Version="1.0.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects CC 2018+ -->
      <Host Name="AEFT" Version="[15.0,99.9]" />
      <!-- Premiere Pro CC 2018+ -->
      <Host Name="PPRO" Version="[12.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.clipcolorchanger.panel.main">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Clip Color Changer</Menu>
          <Geometry>
            <Size>
              <Height>280</Height>
              <Width>320</Width>
            </Size>
            <MinSize>
              <Height>220</Height>
              <Width>260</Width>
            </MinSize>
            <MaxSize>
              <Height>600</Height>
              <Width>600</Width>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./css/icon_dark.png</Icon>
            <Icon Type="DarkNormal">./css/icon_dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>

</ExtensionManifest>
